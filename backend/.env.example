# Supabase Connection Strings (IPv4 Compatible)
# Replace [YOUR-PASSWORD] with your actual Supabase database password

# Transaction Pooler (Used for the app)
DATABASE_URL="postgresql://[USER]:[YOUR-PASSWORD]@[HOST]:6543/postgres"

# Session Pooler (Used for migrations/Studio - IPv4 Compatible)
DIRECT_URL="postgresql://[USER]:[YOUR-PASSWORD]@[HOST]:5432/postgres"

PORT=3001
JWT_SECRET=your_jwt_secret_here

# SMTP / Email configuration (Custom Company Mail Server)
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=user@example.com
SMTP_PASS=your_smtp_password
SMTP_FROM="Your App Name" <user@example.com>
